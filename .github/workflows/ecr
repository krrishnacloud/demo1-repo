name: CI/CD
on: push

env:
   DOCKER_USERNAME: ${{ vars.DOCKERHUB_USERNAME }}
   DOCKER_PASSWORD: ${{ secrets.DOCKERHUB_TOKEN }}
jobs:
  my-job:
    runs-on: ubuntu-latest
    steps:
      - name: checkout repo
        uses: actions/checkout@v5
      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@v5.1.0
          with:
           aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
           aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
           aws-region: us-east-2
      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ vars.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
      - name: Set build timestamp
        run: echo "BUILD_TAG=$(date +%Y%m%d-%H%M%S)" >> $GITHUB_ENV
      - name: Build & Push Docker Images
        run: |
          docker build -t ${{ vars.DOCKERHUB_USERNAME }}/myapp:latest -t ${{ vars.DOCKERHUB_USERNAME }}/myapp:${BUILD_TAG} .
          docker push  ${{ vars.DOCKERHUB_USERNAME }}/myapp:latest
          docker push ${{ vars.DOCKERHUB_USERNAME }}/myapp:${BUILD_TAG}
